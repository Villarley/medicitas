{
  "realm": "medicitas",
  "enabled": true,
  "displayName": "MediCitas",
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      {"name": "admin_plataforma", "description": "Administrador de plataforma"},
      {"name": "admin_clinica", "description": "Administrador de clínica"},
      {"name": "recepcion", "description": "Recepción"},
      {"name": "profesional", "description": "Profesional de salud"}
    ]
  },
  "clients": [
    {
      "clientId": "medicitas-api",
      "name": "API de MediCitas",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "medicitas-api-secret-dev",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "medicitas-cli",
      "name": "Cliente de línea de comandos y pruebas",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.client.audience": "medicitas-api", "access.token.claim": "true", "id.token.claim": "false"}
        },
        {
          "name": "roles-de-realm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {"claim.name": "realm_access.roles", "multivalued": "true", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false"}
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {"access.token.claim": "true", "introspection.token.claim": "true"}
        },
        {
          "name": "usuario",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {"user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true"}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-medicitas-api",
      "enabled": true,
      "serviceAccountClientId": "medicitas-api",
      "clientRoles": {"realm-management": ["manage-users", "view-users", "query-users", "view-realm"]}
    }
  ]
}
