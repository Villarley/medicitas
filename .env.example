# Copiar a .env. Valores solo para desarrollo local.
POSTGRES_DB=medicitas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev
APP_DB_PASSWORD=app-dev
DB_PUERTO_HOST=5432

# La API se conecta con el usuario sin privilegios propios.
DATABASE_URL=postgresql://medicitas_app:app-dev@db:5432/medicitas
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SEGUNDOS=300
# Permite el encabezado X-Sin-Cache: 1 (solo para medir antes/después).
CACHE_PERMITIR_BYPASS=1

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
KEYCLOAK_URL_PUBLICA=http://localhost:8080
KEYCLOAK_URL_INTERNA=http://keycloak:8080
KEYCLOAK_REALM=medicitas
OIDC_ISSUER=http://localhost:8080/realms/medicitas
OIDC_JWKS_URL=http://keycloak:8080/realms/medicitas/protocol/openid-connect/certs
OIDC_AUDIENCIA=medicitas-api
KEYCLOAK_API_CLIENT_ID=medicitas-api
KEYCLOAK_API_CLIENT_SECRET=medicitas-api-secret-dev
KEYCLOAK_CLI_CLIENT_ID=medicitas-cli
CLAVE_USUARIOS_PRUEBA=Medicitas.2026
